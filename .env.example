# Triathlon OS — local environment TEMPLATE (committed; safe — no real values here).
#
# Setup:
#   cp .env.example .env.local      # .env.local is gitignored — your real values go there
#   # paste the real values into .env.local, then load them into your shell:
#   set -a; source .env.local; set +a
#
# NEVER put real values in THIS file. Real secrets live only in .env.local.

# Supabase Cloud DB connection — Dashboard → Settings → Database → Connection string → URI.
# Copy the URI VERBATIM (it has the correct pooler host + user) and fill in your DB password.
# Contains a secret (the DB password). Used by psql to run the pgTAP test suite (SP0).
SUPABASE_DB_URL=

# Supabase project ref — Dashboard → Settings → General → "Reference ID".
# Not secret. Used by `supabase link --project-ref $SUPABASE_PROJECT_REF`.
SUPABASE_PROJECT_REF=
